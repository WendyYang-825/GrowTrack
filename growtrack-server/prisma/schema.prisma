generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 用户表 =====
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nickname     String
  avatarUrl    String?  @map("avatar_url")
  timezone     String   @default("Asia/Shanghai")
  locale       String   @default("zh-CN")
  isPremium    Boolean  @default(false) @map("is_premium")
  onboardedAt  DateTime? @map("onboarded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  timeEntries     TimeEntry[]
  categories      Category[]
  goals           Goal[]
  habits          Habit[]
  habitLogs       HabitLog[]
  refreshTokens   RefreshToken[]
  dailyStats      DailyStat[]
  userSettings    UserSettings?

  @@map("users")
}

// ===== 刷新Token表 =====
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ===== 活动分类表 =====
model Category {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dimension String
  color     String   @default("#12B886")
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  timeEntries TimeEntry[]

  @@index([userId])
  @@map("categories")
}

// ===== 时间记录表（核心业务表） =====
model TimeEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  goalId      String?  @map("goal_id")
  goal        Goal?    @relation(fields: [goalId], references: [id])
  title       String
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  duration    Int
  note        String?
  tags        String[]
  isManual    Boolean  @default(true) @map("is_manual")
  dateKey     DateTime @map("date_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, dateKey])
  @@index([userId, categoryId, dateKey])
  @@index([userId, goalId])
  @@map("time_entries")
}

// ===== 目标表（树形结构） =====
model Goal {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId        String?   @map("parent_id")
  parent          Goal?     @relation("GoalHierarchy", fields: [parentId], references: [id])
  children        Goal[]    @relation("GoalHierarchy")
  title           String
  description     String?
  type            String    @default("weekly")
  status          String    @default("active")
  dimension       String?
  targetDuration  Int?      @map("target_duration")
  targetCount     Int?      @map("target_count")
  deadline       DateTime?
  sortOrder       Int       @default(0) @map("sort_order")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  timeEntries TimeEntry[]

  @@index([userId, status, type])
  @@index([parentId])
  @@map("goals")
}

// ===== 习惯表 =====
model Habit {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  dimension      String   @default("other")
  frequencyType  String   @default("daily") @map("frequency_type")
  frequencyValue Int?     @map("frequency_value")
  icon           String?
  color          String   @default("#12B886")
  reminderTime   String?  @map("reminder_time")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  habitLogs HabitLog[]

  @@index([userId])
  @@map("habits")
}

// ===== 习惯打卡记录表 =====
model HabitLog {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkDate DateTime @map("check_date")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([habitId, checkDate])
  @@index([userId, checkDate])
  @@map("habit_logs")
}

// ===== 每日统计预聚合表 =====
model DailyStat {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  totalDuration    Int      @default(0) @map("total_duration")
  dimensionData    Json     @map("dimension_data")
  goalCompletions  Int      @default(0) @map("goal_completions")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_stats")
}

// ===== 用户设置表 =====
model UserSettings {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String  @default("light")
  weekStartDay     Int     @default(1) @map("week_start_day")
  defaultCategories Json?
  notificationPrefs Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}
