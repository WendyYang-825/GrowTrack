# 数据库连接（Railway 会自动提供 PostgreSQL URL）
# 本地开发时替换为自己的 PostgreSQL 连接
DATABASE_URL="postgresql://user:password@localhost:5432/growtrack"

# JWT 密钥（生产环境请使用随机字符串：openssl rand -hex 32）
JWT_SECRET="your_jwt_secret_here"

# Token 过期时间
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# 服务端口
PORT=3001

# CORS 允许的前端域名（逗号分隔）
# 本地开发：http://localhost:8090
# 生产环境：https://your-app.vercel.app
CORS_ORIGINS="http://localhost:8090,http://localhost:3000"
